{
  "name": "portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "npm run resume:pdf",
    "dev": "node scripts/dev-local.mjs",
    "dev:frontend": "vite",
    "build": "node scripts/update-github-stats.mjs --optional && npm run resume:pdf && tsc -b && vite build",
    "github:update": "node scripts/update-github-stats.mjs",
    "resume:pdf": "node scripts/generate-resume.mjs",
    "lint": "oxlint",
    "test": "node --test --test-isolation=none tests/*.test.mjs",
    "content": "node scripts/content-helper.mjs",
    "preview": "vite preview",
    "arena": "node war-integration/server.ts",
    "test:arena": "node --test --test-isolation=none war-integration/test/*.test.ts",
    "check:arena": "tsc -p war-integration/tsconfig.json",
    "test:engine": "node --test --test-isolation=none war-integration/vendor/test/*.test.ts war-integration/vendor/test/*.test.js",
    "dev:local": "node scripts/dev-local.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "pdfkit": "^0.20.2",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
