{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "strict": true,
    "declaration": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "bench/**/*.ts", "debug/**/*.ts", "scripts/**/*.ts", "game/**/*.ts", "Darwin/**/*.ts"]
}
